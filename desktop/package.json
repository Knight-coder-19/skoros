{
  "name": "skoros-desktop",
  "version": "1.0.0",
  "description": "Skoros - Download videos & images from social media",
  "main": "main.js",
  "scripts": {
    "start": "electron . --dev",
    "build": "electron-builder --dir",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "axios": "^1.13.6"
  },
  "devDependencies": {
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.skoros.app",
    "productName": "Skoros",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "src/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "src/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "src/icon.icns"
    },
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!venv/**"
        ]
      }
    ]
  }
}
